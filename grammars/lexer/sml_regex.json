  "tokens": [
    ["SML_STRING", "^\"(?:\\\\[ \\t\\r\\n\\x0C]+\\\\|\\\\.|[^\\\\\"\\r\\n])*\""],
    ["SML_CHAR", "^#\"(?:\\\\[0-9]{3}|\\\\.|[^\\\\\"\\r\\n])\""],

    ["SML_REAL", "^~?(?:(?:[0-9]+\\.[0-9]+)|(?:[0-9]+(?:\\.[0-9]+)?[eE]~?[0-9]+))"],
    ["SML_WORD", "^0[wW][xX][0-9A-Fa-f]+"],
    ["SML_WORD", "^0[wW][0-9]+"],
    ["SML_INT", "^~?0[xX][0-9A-Fa-f]+"],
