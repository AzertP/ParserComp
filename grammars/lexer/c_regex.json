{
  "skip": [
    "^[ \\t\\r\\n]+",
    "^//[^\\n]*(?:\\n|$)",
    "^/\\*[^*]*\\*+(?:[^/*][^*]*\\*+)*/",
    "^#[^\\n]*(?:\\\\\\n[^\\n]*)*"
  ],
  "tokens": [
    ["STRING", "^L?'(?:\\\\.|[^\\\\'\\n])+'"],
    ["STRING", "^L?\"(?:\\\\.|[^\\\\\"\\n])*\""],

    ["REAL", "^(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?[fFlL]?"],
    ["REAL", "^[0-9]+[eE][+-]?[0-9]+[fFlL]?"],
    ["REAL", "^0[xX](?:[0-9A-Fa-f]+\\.[0-9A-Fa-f]*|\\.[0-9A-Fa-f]+)[pP][+-]?[0-9]+[fFlL]?"],

    ["INTEGER", "^0[xX][0-9A-Fa-f]+(?:[uU](?:ll|LL|l|L)?|(?:ll|LL|l|L)[uU]?)?"],
    ["INTEGER", "^0[0-7]*(?:[uU](?:ll|LL|l|L)?|(?:ll|LL|l|L)[uU]?)?"],
    ["INTEGER", "^[1-9][0-9]*(?:[uU](?:ll|LL|l|L)?|(?:ll|LL|l|L)[uU]?)?"],

    ["ID_OR_KEYWORD", "^[A-Za-z_][A-Za-z0-9_]*"],

    ["OP", "^\\.\\.\\."],
    ["OP", "^>>="],
    ["OP", "^<<="],
    ["OP", "^->"],
    ["OP", "^\\+\\+"],
    ["OP", "^--"],
    ["OP", "^&&"],
    ["OP", "^\\|\\|"],
    ["OP", "^<="],
    ["OP", "^>="],
    ["OP", "^=="],
    ["OP", "^!="],
    ["OP", "^\\+="],
    ["OP", "^-="],
    ["OP", "^\\*="],
    ["OP", "^/="],
    ["OP", "^%="],
    ["OP", "^&="],
    ["OP", "^\\|="],
    ["OP", "^\\^="],
    ["OP", "^>>"],
    ["OP", "^<<"],

    ["OP", "^[{}()\\[\\];,.:?~!+\\-*/%&|^=<>]"]
  ],
  "keywords": [
      "auto", "break", "case", "char", "const", "continue",
      "default", "do", "double", "else", "enum", "extern",
      "float", "for", "goto", "if", "int", "long",
      "register", "return", "short", "signed", "sizeof",
      "static", "struct", "switch", "typedef", "union",
      "unsigned", "void", "volatile", "while"
    ]
}