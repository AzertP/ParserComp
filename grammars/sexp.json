{
  "name": "sexp",
  "start": "<sexp>",
  "rules": {
    "<sexp>": [
      ["<atom>"],
      ["<list>"]
    ],
    "<list>": [
      ["(", ")"],
      ["(", "<sexp>", ")"],
      ["(", "<sexp>", " ", "<list_after_first>", ")"]
    ],
    "<list_after_first>": [
      ["<sexp>"],
      ["<sexp>", " ", "<list_after_first>"],
      [".", " ", "<sexp>"]
    ],
    "<atom>": [
      ["<letter>", "<atom_tail>"]
    ],
    "<atom_tail>": [
      [],
      ["<letter>", "<atom_tail>"],
      ["<digit>", "<atom_tail>"]
    ],
    "<letter>": [
      ["a"],
      ["b"],
      ["c"],
      ["d"],
      ["e"],
      ["f"],
      ["g"],
      ["h"],
      ["i"],
      ["j"],
      ["k"],
      ["l"],
      ["m"],
      ["n"],
      ["o"],
      ["p"],
      ["q"],
      ["r"],
      ["s"],
      ["t"],
      ["u"],
      ["v"],
      ["w"],
      ["x"],
      ["y"],
      ["z"]
    ],
    "<digit>": [
      ["1"],
      ["2"],
      ["3"],
      ["4"],
      ["5"],
      ["6"],
      ["7"],
      ["8"],
      ["9"]
    ]
  },
  "tests": ["(a b c)", "(a . b)", "abc", "a123", "()"]
}
