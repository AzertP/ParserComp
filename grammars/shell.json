{
  "name": "shell",
  "start": "<cmd>",
  "rules": {
    "<cmd>": [
      ["<cmd>", ";", "<cmd>"],
      ["<cmd>", "&", "<cmd>"],
      ["<cmd>", "|", "<cmd>"],
      ["<cmd>", "&", "&", "<cmd>"],
      ["<cmd>", "|", "|", "<cmd>"],
      ["<cmd>", "<redirect>"],
      ["<redirect>", "<cmd>"],
      ["<cmd>", "<assignment>"],
      ["<assignment>", "<cmd>"],
      ["<group>"],
      ["<subshell>"],
      ["<control>"],
      ["<simple>"]
    ],
    "<subshell>": [
      ["(", "<cmd>", ")"]
    ],
    "<group>": [
      ["{", "<cmd>", "}"]
    ],
    "<simple>": [
      ["<word>"],
      ["<simple>", "<word>"]
    ],
    "<word>": [
      ["<literal>"],
      ["<variable>"],
      ["<substitution>"],
      ["<process_substitution>"]
    ],
    "<assignment>": [
      ["<name>", "=", "<word>"],
      ["<assignment>", "<assignment>"]
    ],
    "<variable>": [
      ["$", "<name>"],
      ["$", "{", "<name>", "}"]
    ],
    "<substitution>": [
      ["$", "(", "<cmd>", ")"],
      ["`", "<cmd>", "`"]
    ],
    "<process_substitution>": [
      [">", "(", "<cmd>", ")"],
      ["<", "(", "<cmd>", ")"]
    ],
    "<redirect>": [
      ["<fd>", ">", "<word>"],
      ["<fd>", "<", "<word>"],
      ["<fd>", ">", ">", "<word>"],
      ["<fd>", "<", "<", "<word>"],
      ["<fd>", ">", "&", "<fd>"],
      ["<fd>", "<", "&", "<fd>"],
      ["&", ">", "<word>"],
      ["<", "&", "-"],
      [">", "&", "-"],
      ["<word>", "<redirect>"],
      ["<redirect>", "<redirect>"]
    ],
    "<fd>": [
      ["<number>"],
      []
    ],
    "<number>": [
      ["<digit>"],
      ["<number>", "<digit>"]
    ],
    "<control>": [
      ["<if>"],
      ["<while>"],
      ["<for>"],
      ["<case>"]
    ],
    "<if>": [
      ["i", "f", "<cmd>", "t", "h", "e", "n", "<cmd>", "f", "i"],
      ["i", "f", "<cmd>", "t", "h", "e", "n", "<cmd>", "e", "l", "s", "e", "<cmd>", "f", "i"],
      ["i", "f", "<cmd>", "t", "h", "e", "n", "<cmd>", "e", "l", "i", "f", "<cmd>", "f", "i"],
      ["i", "f", "<cmd>", "t", "h", "e", "n", "<cmd>", "e", "l", "i", "f", "<cmd>", "e", "l", "s", "e", "<cmd>", "f", "i"]
    ],
    "<while>": [
      ["w", "h", "i", "l", "e", "<cmd>", "d", "o", "<cmd>", "d", "o", "n", "e"]
    ],
    "<for>": [
      ["f", "o", "r", "<name>", "i", "n", "<words>", "d", "o", "<cmd>", "d", "o", "n", "e"]
    ],
    "<case>": [
      ["c", "a", "s", "e", "<word>", "i", "n", "<cases>", "e", "s", "a", "c"]
    ],
    "<cases>": [
      ["<case_item>"],
      ["<cases>", "<case_item>"]
    ],
    "<case_item>": [
      ["<pattern>", ")", "<cmd>"],
      ["<pattern>", ")", "<cmd>", ";", ";"]
    ],
    "<words>": [
