{
  "identifier_kind": "ID",
  "skip": [
    "^[ \\t\\r\\n\\x0C]+",
    "^//[^\\n]*(?:\\n|$)",
    "^/\\*(?s:.*?)\\*/",
    "^\\{(?s:.*?)\\}",
    "^\\(\\*(?s:.*?)\\*\\)"
  ],
  "tokens": [
    ["STRING", "^'(?:''|[^'])*'"],
    ["STRING", "^\"(?:\"\"|[^\"])*\""],

    ["REAL", "^[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?"],
    ["REAL", "^[0-9]+(?:[eE][+-]?[0-9]+)"],
    ["INTEGER", "^\\$[0-9A-Fa-f]+"],
    ["INTEGER", "^[0-9]+"],

    ["module", "^(?i:module)\\b"],
    ["private", "^(?i:private)\\b"],
    ["program", "^(?i:program)\\b"],
    ["joins", "^(?i:joins)\\b"],
    ["uses", "^(?i:uses)\\b"],
    ["label", "^(?i:label)\\b"],
    ["const", "^(?i:const)\\b"],
    ["type", "^(?i:type)\\b"],
    ["var", "^(?i:var)\\b"],
    ["fixed", "^(?i:fixed)\\b"],
    ["static", "^(?i:static)\\b"],
    ["array", "^(?i:array)\\b"],
    ["record", "^(?i:record)\\b"],
    ["set", "^(?i:set)\\b"],
    ["file", "^(?i:file)\\b"],
    ["packed", "^(?i:packed)\\b"],
    ["of", "^(?i:of)\\b"],
    ["begin", "^(?i:begin)\\b"],
    ["end", "^(?i:end)\\b"],
    ["case", "^(?i:case)\\b"],
    ["if", "^(?i:if)\\b"],
    ["then", "^(?i:then)\\b"],
    ["else", "^(?i:else)\\b"],
    ["repeat", "^(?i:repeat)\\b"],
    ["until", "^(?i:until)\\b"],
    ["while", "^(?i:while)\\b"],
    ["for", "^(?i:for)\\b"],
    ["to", "^(?i:to)\\b"],
    ["downto", "^(?i:downto)\\b"],
    ["do", "^(?i:do)\\b"],
    ["with", "^(?i:with)\\b"],
    ["goto", "^(?i:goto)\\b"],
    ["procedure", "^(?i:procedure)\\b"],
    ["function", "^(?i:function)\\b"],
    ["result", "^(?i:result)\\b"],
    ["view", "^(?i:view)\\b"],
    ["out", "^(?i:out)\\b"],
    ["read", "^(?i:read)\\b"],
    ["readln", "^(?i:readln)\\b"],
    ["write", "^(?i:write)\\b"],
    ["writeln", "^(?i:writeln)\\b"],
    ["div", "^(?i:div)\\b"],
    ["mod", "^(?i:mod)\\b"],
    ["and", "^(?i:and)\\b"],
    ["or", "^(?i:or)\\b"],
    ["not", "^(?i:not)\\b"],
    ["in", "^(?i:in)\\b"],
    ["nil", "^(?i:nil)\\b"],

    ["ID_OR_KEYWORD", "^[A-Za-z_][A-Za-z0-9_]*"],

    ["[", "^\\(\\."],
    ["]", "^\\.\\)"],
    ["^", "^@"],
    ["and", "^&"],

    ["OP", "^:="],
    ["OP", "^\\.\\."],
    ["OP", "^<>"],
    ["OP", "^<="],
    ["OP", "^>="],
    ["OP", "^<<"],
    ["OP", "^>>"],
    ["OP", "^->"],
    ["OP", "^[()\\[\\],;.:+\\-*/=<>^]"]
  ]
}
